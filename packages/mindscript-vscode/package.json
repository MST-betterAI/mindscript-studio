{
  "name": "mindscript-studio",
  "displayName": "MindScript Studio",
  "description": "MindScript Studio inside VS Code: a coding agent chat panel powered by the MindScript engine (smarter, faster, cheaper model routing).",
  "version": "0.1.3",
  "publisher": "mindscript-ai",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MST-betterAI/mindscript-studio"
  },
  "galleryBanner": {
    "color": "#0b0b12",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "mindscript.participant",
        "fullName": "MindScript",
        "name": "mindscript",
        "description": "Ask MindScript \u2014 routed to the best-value model for the question, cost shown when it answers.",
        "isSticky": true
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mindscript",
          "title": "MindScript",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mindscript": [
        {
          "type": "webview",
          "id": "mindscript.chat",
          "name": "Studio",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "mindscript.open",
        "title": "MindScript: Open Studio"
      },
      {
        "command": "mindscript.openInTab",
        "title": "MindScript: Open Studio in an Editor Tab",
        "icon": "media/icon.svg"
      },
      {
        "command": "mindscript.newSession",
        "title": "MindScript: New Session"
      },
      {
        "command": "mindscript.addToPrompt",
        "title": "MindScript: Add File / Selection to the Prompt"
      },
      {
        "command": "mindscript.copyReference",
        "title": "MindScript: Copy File Reference"
      },
      {
        "command": "mindscript.restartServer",
        "title": "MindScript: Restart Server"
      },
      {
        "command": "mindscript.showStatus",
        "title": "MindScript: Show Status"
      },
      {
        "command": "mindscript.openExistingConversation",
        "title": "MindScript: Open Existing Conversation"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mindscript.openInTab",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mindscript.addToPrompt",
          "group": "mindscript@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mindscript.open",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "mindscript.addToPrompt",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+k",
        "linux": "ctrl+alt+k"
      },
      {
        "command": "editor.action.clipboardCopyAction",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "win": "ctrl+c",
        "linux": "ctrl+c",
        "when": "webviewFocus && activeWebviewPanelId == 'mindscript.tab' || webviewFocus && focusedView == 'mindscript.chat'"
      },
      {
        "command": "editor.action.clipboardPasteAction",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "win": "ctrl+v",
        "linux": "ctrl+v",
        "when": "webviewFocus && activeWebviewPanelId == 'mindscript.tab' || webviewFocus && focusedView == 'mindscript.chat'"
      },
      {
        "command": "editor.action.clipboardCutAction",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "win": "ctrl+x",
        "linux": "ctrl+x",
        "when": "webviewFocus && activeWebviewPanelId == 'mindscript.tab' || webviewFocus && focusedView == 'mindscript.chat'"
      }
    ],
    "configuration": {
      "title": "MindScript Studio",
      "properties": {
        "mindscript.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `mindscript` binary. Empty = look on PATH, then ~/.opencode/bin, then /usr/local/bin."
        },
        "mindscript.baseUrl": {
          "type": "string",
          "default": "",
          "description": "MindScript gateway URL (MINDSCRIPT_BASE_URL), e.g. http://127.0.0.1:8787/v1. Empty = the binary's default."
        },
        "mindscript.port": {
          "type": "number",
          "default": 0,
          "description": "Fixed server port. 0 = a stable port derived from the workspace path (keeps the panel's settings across restarts)."
        },
        "mindscript.routing.auto": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let MindScript balance intelligence, speed and cost for each request. Turn this off to use the dials below. *Not connected to routing yet.*"
        },
        "mindscript.routing.intelligence": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "How much to favour the most capable models, 0-1. Shares one budget with speed and cost. *Not connected to routing yet.*"
        },
        "mindscript.routing.speed": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "How much to favour the fastest models, 0-1. Shares one budget with intelligence and cost. *Not connected to routing yet.*"
        },
        "mindscript.routing.cost": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "How much to favour the cheapest models, 0-1. Shares one budget with intelligence and speed. *Not connected to routing yet.*"
        },
        "mindscript.routing.verbosity": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "How much detail replies should include, 0-1. *Not connected to routing yet.*"
        },
        "mindscript.routing.maxPricePerQuery": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "The most MindScript may spend answering a single question, in USD. 0 = no limit. *Not connected to routing yet.*"
        },
        "mindscript.routing.disabledModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Model ids MindScript may not route to. Everything not listed here stays available. *Not connected to routing yet.*"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "vsix": "node esbuild.js --production && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3"
  }
}
